# Copy to .env.local for local development. Never commit real values.

# Brand (provisional name, change freely)
NEXT_PUBLIC_SITE_NAME=Istmo
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Supabase (Settings > API). The service role key stays on the server only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email sending of proposals.
# Production: EMAIL_PROVIDER=resend with a verified sender domain.
# Local: EMAIL_PROVIDER=smtp pointing at the Mailpit inbox from `npx supabase start` (nothing leaves your machine).
# Non-production Resend requires EMAIL_TEST_RECIPIENT, which receives every message instead of the real recipient.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Istmo <propuestas@example.com>
SMTP_HOST=127.0.0.1
SMTP_PORT=55425
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_TEST_RECIPIENT=

# Optional web research of extra recipients (Tavily). Without it the directory still works.
TAVILY_API_KEY=

# Shared secret for the maintenance endpoints (/api/research/worker, /api/admin/territories).
RESEARCH_WORKER_SECRET=
